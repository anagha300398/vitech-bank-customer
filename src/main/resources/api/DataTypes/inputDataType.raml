#%RAML 1.0 DataType

properties:
  accountNum :
           type: string
           required: true
           minLength: 10
           maxLength: 10
  atmPin : 
           type: string
           required: true
           maxLength: 4
           minLength: 4
  ifscCode: 
           required: true
           minLength: 4
           maxLength: 10
  depositAmount?:          
           type: number
  mailId:
           required: true
           type: string
  contact:
           required: true
           type: number